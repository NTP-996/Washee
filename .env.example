# washee — local env template.

# Frontend (Vite SPA): base URL of the Go backend the app calls.
# Leave empty to use same-origin. Example for local dev against the API on :8099:
# VITE_API_BASE_URL=http://localhost:8099

# /api/book serverless function (mvp v0 funnel — retired once authed /booking ships).
# Production: set these in Vercel → Project → Settings → Environment Variables.
# Local dev:  copy this file to .env and fill it in, then run `vercel dev`.
WASHEE_BOT_TOKEN=
WASHEE_CHAT_ID=
